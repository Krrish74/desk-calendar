{
  "name": "desk-calendar",
  "version": "1.0.0",
  "description": "Dark, Windows 11-style Google Calendar desktop app with an AI assistant",
  "engines": {
    "node": ">=20"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "icons": "electron scripts/make-icons.js",
    "icons:copy": "node scripts/copy-icons.js",
    "test": "node --test \"test/unit/*.test.js\" && electron test/electron/run.js",
    "bench": "electron scripts/bench-assistant.js"
  },
  "build": {
    "appId": "com.local.deskcalendar",
    "productName": "Desk Calendar",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@googleapis/calendar": "^20.2.0",
    "@googleapis/tasks": "^18.0.0",
    "chrono-node": "^2.10.3",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.347",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.3.3": true
  }
}
