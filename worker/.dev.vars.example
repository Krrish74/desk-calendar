# worker/.dev.vars.example: copy to worker/.dev.vars for local testing (`npm run dev`).
# .dev.vars is git-ignored. In production, set each of these with
#   npx wrangler secret put NAME
# instead (see SETUP-IPHONE.md). Never commit real values.

# Only these Google accounts may sign in (comma-separated).
ALLOWED_EMAILS=you@example.com

# Any long random string. Encrypts the stored Google tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_KEY=replace-with-a-long-random-string

# From the "Web application" OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your Claude API key (console.anthropic.com). Optional for testing everything else.
ANTHROPIC_API_KEY=

# Reminders (push notifications). Make the pair once with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
